<style id="wp-custom-css">
/* ── SATCC Trade Verification Form ── */
.satcc-verification-wrapper {
    max-width: 100%;
    margin: 0rem auto;
    padding: 0rem;
    font-family: inherit;
}

.satcc-verification-wrapper h2 {
    margin-bottom: 0.5rem;
}

.satcc-verification-wrapper > p {
    color: #555;
    margin-bottom: 1.5rem;
    line-height: 1.6;
}

.satcc-verification-form .satcc-form-row {
    margin-bottom: 1.25rem;
}

.satcc-verification-form label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: #333;
}

.satcc-verification-form label .required {
    color: #c0392b;
}

.satcc-verification-form input[type="text"],
.satcc-verification-form select {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 1px solid #ccc;
    border-radius: 0px;
    font-size: 1rem;
    box-sizing: border-box;
}

.satcc-verification-form input[type="text"]:focus,
.satcc-verification-form select:focus {
    border-color: #0073aa;
    outline: none;
    box-shadow: 0 0 0 2px rgba(0, 115, 170, 0.2);
}

.satcc-submit-btn {
    background-color: rgb(0, 115, 118);
    color: #fff;
	text-transform: uppercase;
	text-shadow:none;
    border: none;
    padding: 0.75rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 0px;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.satcc-submit-btn:hover {
    background-color: rgb(163, 208, 97);
}

/* ── Result Messages ── */
.satcc-result {
    margin-top: 1.5rem;
	text-shadow:none;
    padding: 1.25rem 1.25rem .15rem 1.25rem;
    border-radius: 0px;
    border-left: 6px solid;
    font-size: 1rem;
    line-height: 1
}

/* Scenario 1: Certified — green */
.satcc-result-certified {
    background-color: #a4d65e;
    border-left-color: #007377;
    color: #000000;
}

/* Scenario 2: Registered Apprentice — blue */
.satcc-result-apprentice {
    background-color: #00767a;
    border-left-color: #a4d65e;
    color: #ffffff;
}

/* Scenario 3: Cannot verify — amber/warning */
.satcc-result-not-found {
    background-color: #ea4335;
    border-left-color: #800000;
    color: #ffffff;
}

/* Scenario 4: Error catch-all — red */
.satcc-result-error {
    background-color: #ea4335;
    border-left-color: #ea4335;
    color: #ffffff;
}


.satcc-reset-btn {
    background-color: rgb(163, 208, 97);
    color: #fff;
	text-transform: uppercase;
	text-shadow:none;
    border: none;
    padding: 0.55rem 2rem .55rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 0px;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

</style>
